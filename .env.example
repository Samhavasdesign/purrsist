# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email ("Still on your list" at each user's local 7am, via Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Purrsist <onboarding@resend.dev>
# Fallback for users whose browser timezone hasn't been saved yet
DIGEST_TIMEZONE=Europe/London
# Origin for the "Enter Today's To-Dos" link (defaults to https://www.purrsist.co)
APP_URL=https://www.purrsist.co
# Signs the login-free "Turn off these emails" links (falls back to CRON_SECRET).
# Changing it breaks the links in emails already sent.
UNSUBSCRIBE_SECRET=generate-another-long-random-string

# Protects /api/cron/* (also set in Vercel project env for Cron)
CRON_SECRET=generate-a-long-random-string
