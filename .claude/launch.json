{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "purrsist-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "storybook",
        "--",
        "--no-open"
      ],
      "port": 6006
    }
  ]
}
